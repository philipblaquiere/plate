{
  "name": "plate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "predev": "npm install --no-audit --no-fund --loglevel=error && npm run build:wasm",
    "dev:api": "cargo run -p plate-server --bin plate -- serve",
    "dev:web": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc --noEmit -p web && vite build",
    "start": "npm run build && cargo run --release -p plate-server --bin plate -- serve",
    "typecheck": "tsc --noEmit -p web",
    "test": "cargo test --workspace && npm run build:wasm && npm run typecheck && vitest run",
    "test:web": "vitest run",
    "format": "prettier --write web vite.config.ts && cargo fmt --all",
    "format:check": "prettier --check web vite.config.ts && cargo fmt --all -- --check",
    "prestart": "npm install --no-audit --no-fund --loglevel=error"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "monaco-editor": "^0.57.0"
  },
  "engines": {
    "node": ">=20"
  }
}
